# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริงของโปรเจกต์ Supabase ของคุณ
# หาค่าได้ที่ Supabase Dashboard → Project Settings → API
# ไฟล์ .env.local ต้องไม่ถูก commit ขึ้น git ส่วนไฟล์ตัวอย่างนี้ commit ได้
# แก้ค่าแล้วต้องปิดและเปิด npm run dev ใหม่ เพราะ Next.js อ่านค่าตอนเริ่มทำงาน

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
